    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.12",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "pdfjs-dist": "5.4.296",
    "rollup": "npm:@rollup/wasm-node@4.68.5",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vitest": "3.2.6"
  },
  "overrides": {
    "rollup": "$rollup"
  }
}
